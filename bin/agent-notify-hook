#!/usr/bin/env bash
set -euo pipefail

SOURCE="${1:-agent}"
EVENT="${2:-complete}"

INPUT="$(cat 2>/dev/null || true)"
TEXT=""
DIR=""
if [[ -n "$INPUT" ]] && command -v jq >/dev/null 2>&1; then
  TEXT="$(jq -r '.last_assistant_message // .message // .tool_name // empty' <<<"$INPUT" 2>/dev/null || true)"
  DIR="$(jq -r '.cwd // empty' <<<"$INPUT" 2>/dev/null || true)"

  if [[ "$SOURCE" == "codex" && "$EVENT" == "permission" ]]; then
    AGENT_ID="$(jq -r '.agent_id // empty' <<<"$INPUT" 2>/dev/null || true)"
    MODE="$(jq -r '.permission_mode // empty' <<<"$INPUT" 2>/dev/null || true)"
    [[ -n "$AGENT_ID" ]] && exit 0
    case "$MODE" in
      bypassPermissions | dontAsk) exit 0 ;;
    esac
  fi
fi

exec agent-notify "$SOURCE" "$EVENT" "$TEXT" "$DIR"
